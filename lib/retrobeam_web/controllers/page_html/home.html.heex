<Layouts.flash_group flash={@flash} />
<div class="px-4 py-16 sm:px-6 sm:py-24 lg:px-8 xl:px-28 xl:py-32">
  <div class="mx-auto max-w-2xl">
    <div class="flex justify-between items-center">
      <div class="flex items-center gap-2">
        <.icon name="hero-signal" class="size-7 text-primary" />
        <span class="text-lg font-bold tracking-tight">RetroBeam</span>
      </div>
      <Layouts.theme_toggle />
    </div>

    <h1 class="text-4xl sm:text-5xl mt-10 font-bold leading-tight tracking-tight text-balance">
      Better retros.<br />Stronger teams.
    </h1>
    <p class="mt-4 text-lg leading-7 text-base-content/70 max-w-lg">
      Run focused, collaborative sprint retrospectives that surface real insights.
      Real-time collaboration, anonymous voting, and AI-powered summaries — all in one place.
    </p>

    <div class="mt-10 flex flex-col sm:flex-row gap-4">
      <a href={~p"/users/register"} class="btn btn-primary btn-lg">
        Get started free <span aria-hidden="true">&rarr;</span>
      </a>
      <a href={~p"/users/log-in"} class="btn btn-ghost btn-lg">
        Log in
      </a>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-8 sm:grid-cols-3">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex items-center justify-center size-10 rounded-box bg-primary/10">
            <.icon name="hero-chat-bubble-left-right" class="size-5 text-primary" />
          </span>
          <h2 class="font-semibold">Real-time collaboration</h2>
        </div>
        <p class="text-sm leading-6 text-base-content/60">
          Everyone contributes simultaneously. See cards appear live as your team shares feedback.
        </p>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex items-center justify-center size-10 rounded-box bg-secondary/10">
            <.icon name="hero-hand-thumb-up" class="size-5 text-secondary" />
          </span>
          <h2 class="font-semibold">Anonymous voting</h2>
        </div>
        <p class="text-sm leading-6 text-base-content/60">
          Prioritize what matters most. Dot-voting surfaces the topics your team cares about.
        </p>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <span class="flex items-center justify-center size-10 rounded-box bg-accent/10">
            <.icon name="hero-sparkles" class="size-5 text-accent" />
          </span>
          <h2 class="font-semibold">AI-powered summaries</h2>
        </div>
        <p class="text-sm leading-6 text-base-content/60">
          Get actionable takeaways automatically. AI distills your retro into clear action items.
        </p>
      </div>
    </div>
  </div>
</div>
